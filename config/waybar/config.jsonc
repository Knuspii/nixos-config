{
  "layer": "top",
  "position": "bottom",
  "height": 45,
  "spacing": 1,

  "modules-left": ["custom/nixos", "custom/fuzzel", "niri/workspaces"],

  "modules-center": ["clock", "custom/date"],

  "modules-right": [
    "tray",
    "custom/separator",
    "network",
    "cpu",
    "memory",
    "custom/separator",
    "wireplumber",
    "custom/cava",
    "custom/separator",
    "custom/notification",
  ],

  "custom/separator": {
    "format": "┃",
    "tooltip": false
  },

  // NixOS
  "custom/nixos": {
    "format": " ",
    "tooltip": false,
  },

  // App Launcher
  "custom/fuzzel": {
    "format": "《 󰍉 Apps 》",
    "on-click": "fuzzel",
    "tooltip": false,
  },

  // Niri Workspaces
  "niri/workspaces": {
    "format": "[ {icon} ]",
    "format-icons": {
      "active": "◉",
      "default": "○",
    },
  },

  "custom/cava": {
      "format": "{}",
      "exec": "~/.config/waybar/cava.sh"
  },

  // Current Window
  "niri/window": {
    "format": "[ {title} ]",
    "escape": true,
    "max-length": 40,
    "separate-outputs": true,
  },

  // Network
  "network": {
    "format-wifi": "󰖩 WLAN",
    "format-ethernet": "󰈀 LAN",
    "format-disconnected": "󰖪 OFF",
    "on-click": "ghostty -e nmtui",
    "interval": 5
  },

  // CPU
  "cpu": {
    "format": "󰍛 {usage}%",
    "interval": 5,
  },

  // RAM
  "memory": {
    "format": "󰘚 {percentage}%",
    "interval": 5,
  },

  // Audio
  "wireplumber": {
    "format": "󰕾 {volume}%",
    "format-muted": "󰖁 MUTE",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },

  "clock": {
    "format": "《 󰥔 {:%H:%M}",
    "interval": 60,
    "tooltip": false,
  },

  "custom/date": {
    "format": "· 󰃭 {} 》",
    "exec": "date '+%d.%m.%Y'",
    "interval": 60,
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
  },

  // Notifications
  "custom/notification": {
    "format": "󰂚 ",
    "on-click": "makoctl dismiss -a",
    "tooltip": false,
  },

  // System Tray
  "tray": {
    "icon-size": 20,
    "spacing": 6,
  },
}
