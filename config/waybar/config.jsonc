{
    "layer": "top",
    "position": "bottom",
    "height": 36,
    "spacing": 6,
    "modules-left": [
        "custom/nixos",
        "custom/fuzzel",
        "niri/workspaces",
        "mpris"
    ],
    "modules-center": [
        "niri/window"
    ],
    "modules-right": [
        "gamemode",
        "network",
        "cpu",
        "memory",
        "wireplumber",
        "clock",
        "custom/notification"
    ],

    // Module Configurations
    "custom/nixos": {
        "format": "[   nixos ]",
        "tooltip": false
    },
    "custom/fuzzel": {
        "format": "[ 󰍉 apps ]",
        "on-click": "fuzzel",
        "tooltip": false
    },
    "niri/workspaces": {
        "format": "[ {icon} ]",
        "format-icons": {
            "active": "",
            "default": ""
        }
    },
    "niri/window": {
        "format": "[ {title} ]",
        "escape": true,
        "max-length": 40,
        "separate-outputs": true
    },
    "mpris": {
        "format": "[ 󰎈 {player_icon} {dynamic} ]",
        "format-paused": "[ 󰎈 {status_icon} {dynamic} ]",
        "player-icons": {
            "default": "▶"
        },
        "status-icons": {
            "paused": "⏸"
        },
        "dynamic-len": 25,
        "tooltip": false
    },
    "gamemode": {
        "format": "[ 󰊴 ON ]",
        "format-alt": "[ 󰊴 OFF ]",
        "hide-not-running": true,
        "use-icon": false
    },
    "network": {
        "format-wifi": "[ 󰖩 UP ]",
        "format-ethernet": "[ 󰈀 UP ]",
        "format-disconnected": "[ 󰖪 DOWN ]",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 5
    },
    "cpu": {
        "format": "[ 󰻠 {usage}% ]",
        "interval": 2
    },
    "memory": {
        "format": "[ 󰍛 {percentage}% ]",
        "interval": 2
    },
    "wireplumber": {
        "format": "[ 󰕾 {volume}% ]",
        "format-muted": "[ 󰖁 MUTE ]",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "clock": {
        "format": "[ 󰥔 {:%H:%M:%S} ]",
        "interval": 1,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "custom/notification": {
        "format": "[ 󰂚 ]",
        "on-click": "makoctl dismiss -a",
        "tooltip": false
    }
}
